# Use a specific, stable miniconda tag based on Python 3.8.5
FROM continuumio/miniconda3:4.9.2

# Fix Buster apt repositories
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list \
    && sed -i 's|http://security.debian.org/debian-security|http://archive.debian.org/debian-security|g' /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99disable-check-valid-until

# 1. Install system dependencies including LaTeX
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ make flex bison git gfortran \
    texlive texlive-latex-extra cm-super dvipng ghostscript \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 1. Install git (Conda package)
RUN conda install -y git

# Set a base working directory
WORKDIR /app

# Clone the GELATO repository from GitHub
RUN git clone https://github.com/TheSkyentist/GELATO.git

# Set the working directory to the cloned repo
WORKDIR /app/GELATO

# Pin numpy to 1.26.4 to avoid the np.float_ error
RUN sed -i 's/- numpy/- numpy=1.26.4/' environment.yml

# Create the Conda environment from the .yml file
RUN conda env create -f environment.yml

# Install the GELATO package itself (pip install .)
RUN conda run -n gelato pip install .

# Set the environment path to use the 'gelato' env by default
ENV PATH=/opt/conda/envs/gelato/bin:$PATH

# Ensure Matplotlib uses a non-interactive backend for plots in the container
ENV MPLBACKEND=Agg

# Set the final working directory to the Example folder
WORKDIR /app/GELATO/Example

# Run the example script as the default command
CMD ["python", "../Convenience/runGELATO.py", "ExampleParameters.json", "ExampleObjList.csv"]