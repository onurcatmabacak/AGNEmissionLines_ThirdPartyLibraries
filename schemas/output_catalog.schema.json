{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onurcatmabacak/AGNEmissionLines_ThirdPartyLibraries/schemas/output_catalog.schema.json",
  "title": "AGN emission-line output catalogue",
  "description": "Formal machine-readable contract for every outputs/<tool>/<source>_z_<z>/ product tree. The catalogue is generated by pipeline/build_output_manifest.py and validated by pipeline/validate_outputs.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_utc",
    "source_count",
    "tool_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "tool_count": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_key",
          "tool",
          "kind",
          "run_status",
          "headline",
          "caveats",
          "provenance",
          "artifacts"
        ],
        "properties": {
          "source_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.+-]+_z_[0-9.]+$"
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sed",
              "line",
              "host",
              "ratio",
              "reference",
              "unknown"
            ]
          },
          "run_status": {
            "type": "string",
            "minLength": 1
          },
          "headline": {
            "type": "object"
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_json"
            ],
            "properties": {
              "run_json": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "role",
                "media_type",
                "bytes",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^outputs/"
                },
                "role": {
                  "enum": [
                    "figure",
                    "table",
                    "metadata",
                    "data",
                    "report",
                    "log",
                    "other"
                  ]
                },
                "media_type": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "quality": {
            "enum": [
              "production",
              "conditional",
              "reference",
              "postprocess",
              "excluded",
              "unknown"
            ]
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "caveat": {
            "type": "string"
          }
        }
      }
    }
  }
}
