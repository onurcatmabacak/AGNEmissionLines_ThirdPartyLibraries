{
  "_comment": "QGfit 1.0.0 continuum + emission-line fit for the SDSS QSO sample. Wavelengths are rest-frame angstrom; fluxes use the SDSS 1e-17 erg s-1 cm-2 A-1 unit. The committed demonstration run uses a short continuum MCMC (40 walkers x 100 steps) and least-squares line covariance; see Tools/qgfit/README.md.",
  "z": null,
  "mask_and_mask": true,
  "qgfit": {
    "do_deredden": false,
    "wave_range": [1275.0, 8150.0],
    "conti_pl": true,
    "conti_fe_uv": true,
    "conti_fe_op": true,
    "conti_balmer": false,
    "conti_host": true,
    "host_tie": "same",
    "check_kmpfit": true,
    "check_nelder": false,
    "conti_redchi_limit": 1.5,
    "line_redchi_limit": 1.5,
    "conti_mcmc": true,
    "conti_workers": 1,
    "conti_nwalkers": 40,
    "conti_steps": 100,
    "conti_burn": 20,
    "conti_thin": 1,
    "conti_progress": false,
    "save_conti_chains": true,
    "line_mcmc": false,
    "line_fit": true,
    "mask_lowSN": false,
    "SN_mask": 1.0,
    "test_add_broad": false,
    "tie_width": true,
    "tie_shift": true,
    "tie_flux": true,
    "comp_plot": ["Ha", "Hb", "Hd", "He", "Hr", "MgII", "CIII", "CIV", "Lya"],
    "plot": false,
    "plot_line": true,
    "plot_conti_mcmc_corner": true,
    "prop": true,
    "verbose_conti": true,
    "verbose_line": false
  },
  "reference_tools": ["pyqsofit_uv", "gandalf_line", "s3fit_line"]
}
