      "jwst.miri.mrs.ch1.C",
      "jwst.miri.mrs.ch2.A",
      "jwst.miri.mrs.ch2.B",
      "jwst.miri.mrs.ch2.C",
      "jwst.miri.mrs.ch3.A",
      "jwst.miri.mrs.ch3.B",
      "jwst.miri.mrs.ch3.C",
      "jwst.miri.mrs.ch4.A",
      "jwst.miri.mrs.ch4.B",
