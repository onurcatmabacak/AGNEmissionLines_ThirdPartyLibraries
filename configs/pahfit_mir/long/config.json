{
  "schema_version": 1,
  "name": "long",
  "description": "PDS 456 MIRI long production fit: 0.05 um bin, rest 5-28 um, warm-started from a normalized pipeline seed, 100 MC.",
  "input": {
    "instrument": [
      "jwst.miri.mrs.ch1.A",
      "jwst.miri.mrs.ch1.B",
      "jwst.miri.mrs.ch1.C",
      "jwst.miri.mrs.ch2.A",
      "jwst.miri.mrs.ch2.B",
      "jwst.miri.mrs.ch2.C",
      "jwst.miri.mrs.ch3.A",
      "jwst.miri.mrs.ch3.B",
      "jwst.miri.mrs.ch3.C",
      "jwst.miri.mrs.ch4.A",
      "jwst.miri.mrs.ch4.B",
      "jwst.miri.mrs.ch4.C"
    ],
    "segment": "long",
    "s1d": false,
    "tbl": false,
    "smooth_um": 0.05,
    "min_wave": 5.0,
    "max_wave": 28.0,
    "aperture_arcsec2": 0.04,
    "tbl_aperture_arcsec2": 1.0
  },
  "fit": {
    "maxiter": 5000,
    "passes": 2,
    "no_guess": false,
    "init_from": "seed/pahfit_output.ecsv",
    "normalize": true,
    "clip_nmad": 0.0,
    "clip_iterations": 1
  },
  "monte_carlo": {
    "enabled": false,
    "samples": 100,
    "method": "auto",
    "seed": 12347,
    "rcond": 1e-10,
    "maxiter": 2000,
    "bootstrap_mode": "parametric",
    "scale": "none",
    "save_samples": true
  },
  "warm_start": {
    "mode": "pipeline_seed",
    "from_variant": "long",
    "seed_args": [
      "--segment",
      "long",
      "--smooth-um",
      "0.05",
      "--max-wave",
      "18.0",
      "--normalize-fit",
      "--maxiter",
      "5000",
      "--fit-passes",
      "2"
    ],
    "note": "pipeline/run_new_tools.py runs the normalized seed fit and copies its ECSV to <output>/seed/."
  }
}
