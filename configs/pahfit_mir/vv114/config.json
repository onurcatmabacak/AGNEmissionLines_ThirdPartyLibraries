{
  "schema_version": 1,
  "name": "vv114",
  "description": "VV114 full 12-channel MIRI MRS s1d production fit: native sampling, 5-28 um, 9 arcsec^2 flux-density aperture, robust cosmic-ray clipping, 200 MC.",
  "input": {
    "instrument": [
      "jwst.miri.mrs.ch1.A",
      "jwst.miri.mrs.ch1.B",
      "jwst.miri.mrs.ch1.C",
      "jwst.miri.mrs.ch2.A",
      "jwst.miri.mrs.ch2.B",
      "jwst.miri.mrs.ch2.C",
      "jwst.miri.mrs.ch3.A",
      "jwst.miri.mrs.ch3.B",
      "jwst.miri.mrs.ch3.C",
      "jwst.miri.mrs.ch4.A",
      "jwst.miri.mrs.ch4.B",
      "jwst.miri.mrs.ch4.C"
    ],
    "segment": "both",
    "s1d": true,
    "tbl": false,
    "smooth_um": null,
    "min_wave": 5.0,
    "max_wave": 28.0,
    "aperture_arcsec2": 9.0,
    "tbl_aperture_arcsec2": 1.0
  },
  "fit": {
    "maxiter": 2000,
    "passes": 2,
    "no_guess": false,
    "init_from": null,
    "normalize": true,
    "clip_nmad": 6.0,
    "clip_iterations": 2
  },
  "monte_carlo": {
    "enabled": false,
    "samples": 200,
    "method": "auto",
    "seed": 12349,
    "rcond": 1e-10,
    "maxiter": 500,
    "bootstrap_mode": "parametric",
    "scale": "none",
    "save_samples": true
  }
}
