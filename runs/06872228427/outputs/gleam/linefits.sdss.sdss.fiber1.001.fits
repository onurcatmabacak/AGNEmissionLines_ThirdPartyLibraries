TTYPE29 = 'detected'                                                            TFORM29 = 'L       '                                                            TTYPE30 = 'covered '                                                            TFORM30 = 'L       '                                                            COMMENT --BEGIN-ASTROPY-SERIALIZED-COLUMNS--                                    COMMENT datatype:                                                               COMMENT - {name: wavelength, unit: Angstrom, datatype: float64}                 COMMENT - {name: line, datatype: string}                                        COMMENT - {name: latex, datatype: string}                                       COMMENT - {name: z, datatype: float32, description: 'Source redshift, from spe\ COMMENT cpro'}                                                                  COMMENT - {name: zline, unit: '', datatype: float32, description: Redshift cal\ COMMENT culated from this emission line}                                        COMMENT - {name: zline_err, unit: '', datatype: float32, description: Error on\ COMMENT  the redshift calculated from this emission line}                       COMMENT - {name: zoffset, unit: '', datatype: float32, description: Redshift o\ COMMENT ffset between line and specpro redshift}                                COMMENT - {name: zoffset_err, unit: '', datatype: float32, description: Error \ COMMENT on the redshift offset}                                                 COMMENT - {name: cont, unit: erg / (Angstrom cm2 s), datatype: float32, descri\ COMMENT ption: 'Continuum around line, Gaussian fit'}                           COMMENT - {name: cont_err, unit: erg / (Angstrom cm2 s), datatype: float32, de\ COMMENT scription: 'Error on continuum around line, Gaussian fit'}              COMMENT - {name: wl, unit: Angstrom, datatype: float32, description: 'Restfram\ COMMENT e wavelength, Gaussian fit'}                                            COMMENT - {name: wl_err, unit: Angstrom, datatype: float32, description: 'Erro\ COMMENT r on restframe wavelength, Gaussian fit'}                               COMMENT - {name: height, unit: erg / (Angstrom cm2 s), datatype: float32, desc\ COMMENT ription: 'Height, Gaussian fit'}                                        COMMENT - {name: height_err, unit: erg / (Angstrom cm2 s), datatype: float32, \ COMMENT description: 'Error on height, Gaussian fit'}                           COMMENT - {name: sigma, unit: Angstrom, datatype: float32, description: 'Sigma\ COMMENT , Gaussian fit'}                                                        COMMENT - {name: sigma_err, unit: Angstrom, datatype: float32, description: 'E\ COMMENT rror on sigma, Gaussian fit'}                                           COMMENT - {name: amplitude, unit: erg / (cm2 s), datatype: float32, descriptio\ COMMENT n: 'Amplitude, Gaussian fit'}                                           COMMENT - {name: amplitude_err, unit: erg / (cm2 s), datatype: float32, descri\ COMMENT ption: 'Error on amplitude, Gaussian fit'}                              COMMENT - {name: flux, unit: erg / (cm2 s), datatype: float32, description: 'L\ COMMENT ine flux, Gaussian fit'}                                                COMMENT - {name: flux_err, unit: erg / (cm2 s), datatype: float32, description\ COMMENT : 'Error on line flux, Gaussian fit'}                                   COMMENT - {name: luminosity, unit: 1e+56 erg / s, datatype: float32, descripti\ COMMENT on: 'Line luminosity, Gaussian fit'}                                    COMMENT - {name: luminosity_err, unit: 1e+56 erg / s, datatype: float32, descr\ COMMENT iption: 'Error on line luminosity, Gaussian fit'}                       COMMENT - {name: EWrest, unit: Angstrom, datatype: float32, description: 'Rest\ COMMENT frame line equivalent width, Gaussian fit'}                             COMMENT - {name: EWrest_err, unit: Angstrom, datatype: float32, description: '\ 