COMMENT - {name: wl_err, unit: Angstrom, datatype: float32, description: 'Erro\ COMMENT r on restframe wavelength, Gaussian fit'}                               COMMENT - {name: height, unit: erg / (Angstrom cm2 s), datatype: float32, desc\ COMMENT ription: 'Height, Gaussian fit'}                                        COMMENT - {name: height_err, unit: erg / (Angstrom cm2 s), datatype: float32, \ COMMENT description: 'Error on height, Gaussian fit'}                           COMMENT - {name: sigma, unit: Angstrom, datatype: float32, description: 'Sigma\ COMMENT , Gaussian fit'}                                                        COMMENT - {name: sigma_err, unit: Angstrom, datatype: float32, description: 'E\ COMMENT rror on sigma, Gaussian fit'}                                           COMMENT - {name: amplitude, unit: erg / (cm2 s), datatype: float32, descriptio\ COMMENT n: 'Amplitude, Gaussian fit'}                                           COMMENT - {name: amplitude_err, unit: erg / (cm2 s), datatype: float32, descri\ COMMENT ption: 'Error on amplitude, Gaussian fit'}                              COMMENT - {name: flux, unit: erg / (cm2 s), datatype: float32, description: 'L\ COMMENT ine flux, Gaussian fit'}                                                COMMENT - {name: flux_err, unit: erg / (cm2 s), datatype: float32, description\ COMMENT : 'Error on line flux, Gaussian fit'}                                   COMMENT - {name: luminosity, unit: 1e+56 erg / s, datatype: float32, descripti\ COMMENT on: 'Line luminosity, Gaussian fit'}                                    COMMENT - {name: luminosity_err, unit: 1e+56 erg / s, datatype: float32, descr\ COMMENT iption: 'Error on line luminosity, Gaussian fit'}                       COMMENT - {name: EWrest, unit: Angstrom, datatype: float32, description: 'Rest\ COMMENT frame line equivalent width, Gaussian fit'}                             COMMENT - {name: EWrest_err, unit: Angstrom, datatype: float32, description: '\ 