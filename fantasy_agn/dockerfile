# Use official Python 3.9 image (fantasy_agn 0.7.3 + pinned pandas 1.3.4 and
# matplotlib 3.4.3 only ship manylinux wheels for CPython <= 3.9)
FROM python:3.9

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc g++ make flex bison git gfortran\
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
# Set working directory inside the container
WORKDIR /app

# Copy requirements.txt first (if you have one) to leverage Docker cache
# COPY requirements.txt .

# Install dependencies
# RUN pip install --no-cache-dir -r requirements.txt

RUN pip install --upgrade pip wheel
RUN pip install "fantasy_agn==0.7.3"
# sherpa >=4.16 moved SherpaFloat from sherpa.utils to sherpa.data; keep
# fantasy_agn importable (no-op on older sherpa where the pattern is absent).
RUN sed -i 's/^from sherpa.utils import SherpaFloat, sao_fcmp$/from sherpa.utils import sao_fcmp\nfrom sherpa.data import SherpaFloat/' \
    /usr/local/lib/python3.9/site-packages/fantasy_agn/models.py

# Copy the rest of your code
COPY ./main.py .
# Synthetic placeholder spectrum only. The pipeline mounts the real per-object
# spectrum over this path at run time, so no proprietary data is shipped.
RUN python -c "import numpy as np; from astropy.io import fits; w=np.logspace(np.log10(3600.0), np.log10(10400.0), 1000); c=[fits.Column(name='flux', format='E', array=np.ones(1000, dtype='f4')), fits.Column(name='loglam', format='E', array=np.log10(w).astype('f4')), fits.Column(name='ivar', format='E', array=np.ones(1000, dtype='f4')), fits.Column(name='wdisp', format='E', array=np.full(1000, 1e-4, dtype='f4'))]; fits.HDUList([fits.PrimaryHDU(), fits.BinTableHDU.from_columns(c), fits.BinTableHDU.from_columns([fits.Column(name='z', format='E', array=np.array([0.0], dtype='f4'))])]).writeto('my_sdss.fits', overwrite=True)"

# Define the command to run your application
# CMD ["sh", "-c", "ls -hl && python main.py"]
CMD ["sh", "-c", "ls -hl && python main.py > /app/output/fit.log" ]