# Dedicated FIR line fitter (PACS/SOFIA/ALMA-style)
# Build context is the repo root:
#   docker build -f fir_linefit/dockerfile -t fir_linefit .
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 MPLBACKEND=Agg
WORKDIR /app
COPY Tools/pipeline_ir/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY Tools/pipeline_ir /app/pipeline_ir
COPY Tools/fir_linefit/run_fir.py /app/run_fir.py
RUN mkdir -p /app/input /app/output && chmod 777 /app/output
ENTRYPOINT ["python", "/app/run_fir.py"]
