# CASA 6 spectral-line fitting (specfit) as an independent cross-check.
#
# CASA 6 is on conda-forge (casatools + casatasks), which resolves the OpenSSL
# and ABI dependencies that the bare pip wheels get wrong (they need
# OPENSSL_3.0.1/3.2.0 symbol versions that Debian's libcrypto does not carry).
# The multi-GB NRAO tarball is therefore not needed.
FROM mambaorg/micromamba:1.5.10

USER root
ENV PYTHONUNBUFFERED=1 MPLBACKEND=Agg OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 \
    CASASITECONFIG=/app/casasiteconfig.py

RUN micromamba install -y -n base -c conda-forge \
      "python=3.12" "casatools>=6.7" "casatasks>=6.7" \
      "numpy<2.1" "astropy>=6" "matplotlib>=3.8" "pandas>=2" \
 && micromamba clean --all --yes

COPY Tools/casa_specfit/casasiteconfig.py /app/casasiteconfig.py
COPY Tools/casa_specfit/run_casa_specfit.py /app/run/run_casa_specfit.py
COPY Tools/casa_specfit/README.md /app/run/README.md
COPY configs/casa_specfit/default /app/config

RUN mkdir -p /app/input /app/output /tmp/mpl && chmod 777 /app/output /tmp/mpl \
 && /opt/conda/bin/python -c "import casatools, casatasks; print('CASA ok', casatools.version_string())"

WORKDIR /app/run
ENTRYPOINT []
CMD ["/opt/conda/bin/python", "/app/run/run_casa_specfit.py", "--input", "/app/input", \
     "--output", "/app/output", "--config", "/app/config/config.json"]
