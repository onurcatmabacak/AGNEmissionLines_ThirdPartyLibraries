# Cross-band emission-line ratio comparer
# Build context is the repo root:
#   docker build -f crossband/dockerfile -t crossband .
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 MPLBACKEND=Agg
WORKDIR /app
RUN pip install --no-cache-dir numpy matplotlib
COPY Tools/crossband/run_crossband.py /app/run_crossband.py
RUN mkdir -p /app/input /app/output && chmod 777 /app/output
ENTRYPOINT ["python", "/app/run_crossband.py"]
