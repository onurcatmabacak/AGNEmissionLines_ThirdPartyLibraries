# S3Fit 2.2.6 simultaneous spectrum + photometric-SED / emission-line fit.
# Build context is the repository root:
#   docker build -f Tools/s3fit_line/dockerfile -t s3fit_line .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    S3FIT_CONFIG=/app/config \
    S3FIT_MODEL_ROOT=/app/s3fit_line \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Tools/s3fit_line/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY Tools/s3fit_line/run_s3fit.py /app/s3fit_line/run_s3fit.py
COPY Tools/s3fit_line/model_libraries /app/s3fit_line/model_libraries
COPY Tools/s3fit_line/filters /app/s3fit_line/filters
COPY configs/s3fit_line /app/config

RUN mkdir -p /app/input /app/output && chmod 777 /app/output

ENTRYPOINT ["python", "/app/s3fit_line/run_s3fit.py"]
