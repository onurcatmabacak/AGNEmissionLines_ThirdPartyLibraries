# AGNfitter-rx (AGNfitter 2.0) SED/torus engine
# Build context is the repo root:
#   docker build -f agnfitter_sed/dockerfile -t agnfitter_sed .
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 MPLBACKEND=Agg PYTHONPATH=/app/AGNfitter
RUN apt-get update && apt-get install -y --no-install-recommends \
      git gcc g++ gfortran libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone --depth 1 https://github.com/GabrielaCR/AGNfitter.git /app/AGNfitter
RUN sed -i "s/from collections import Iterable/from collections.abc import Iterable/" /app/AGNfitter/functions/PARAMETERSPACE_AGNfitter.py
RUN sed -i "s/delim_whitespace=True/sep=chr(92)+\"s+\"/" /app/AGNfitter/functions/DATA_AGNfitter.py
RUN sed -i "s/np\.float\b/np.float64/g" /app/AGNfitter/functions/*.py
RUN sed -i "s/usetex=True/usetex=False/g" /app/AGNfitter/functions/PLOTandWRITE_AGNfitter.py
RUN sed -i "s/units_flags = self.cat\['flux_unit'\].value/units_flags = 1.0/g" /app/AGNfitter/functions/DATA_AGNfitter.py
RUN pip install --no-cache-dir "numpy==1.26.4" "scipy==1.11.4" matplotlib astropy emcee ultranest corner "pandas==1.5.3" setuptools wheel h5py
RUN pip install --no-cache-dir --no-build-isolation acor
COPY Tools/agnfitter_sed/run_agnfitter.py /app/run_agnfitter.py
RUN mkdir -p /app/input /app/output && chmod 777 /app/output
ENTRYPOINT ["python", "/app/run_agnfitter.py"]
