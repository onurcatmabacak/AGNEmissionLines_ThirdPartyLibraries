# QGfit 1.0.0 (https://github.com/qian-yang/QGfit, commit 3aed692)
# Build context is the repository root:
#   docker build --network=host -t qgfit -f Tools/qgfit/dockerfile .
#
# QGfit's README recommends Python 3.8 and Kapteyn.  Kapteyn 2.3.1 needs a
# source build: its PyPI tarball contains C files generated by Cython 0.23
# (incompatible with Python 3.8's PyThreadState), and setup.py pulls the latest
# Cython through setup_requires.  We remove the generated C files, drop the
# setup_requires entry and build against NumPy 1.21.6, then upgrade NumPy to
# the version QGfit pins (1.23.3).
FROM python:3.8-slim

ENV PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    SFD_PATH=/opt/sfd

RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc g++ gfortran libgomp1 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Base scientific stack (NumPy 1.21.6 is only for building Kapteyn).
COPY Tools/qgfit/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Build Kapteyn (kmpfit) from source.
RUN pip download --no-deps --no-binary=:all: kapteyn==2.3.1 -d /tmp/kap && \
    tar xzf /tmp/kap/kapteyn-2.3.1.tar.gz -C /tmp && \
    sed -i 's/setup_requires=\["Cython", "numpy"\]/setup_requires=[]/' \
        /tmp/kapteyn-2.3.1/setup.py && \
    rm -f /tmp/kapteyn-2.3.1/src/wcs.c \
          /tmp/kapteyn-2.3.1/src/ascarray.c \
          /tmp/kapteyn-2.3.1/src/profiles.c \
          /tmp/kapteyn-2.3.1/src/kmpfit.c && \
    cd /tmp/kapteyn-2.3.1 && \
    python setup.py install --single-version-externally-managed \
        --record=/tmp/kapteyn-record.txt && \
    cd / && rm -rf /tmp/kapteyn-2.3.1 /tmp/kap

# QGfit pins NumPy 1.23.3 at runtime; the Kapteyn extension built against
# 1.21 headers remains ABI-compatible.
RUN pip install --no-cache-dir --upgrade numpy==1.23.3

# QGfit source (vendored, with its Fe II and BC03 template data).
COPY Tools/qgfit/third_party /app/qgfit_src
RUN pip install --no-cache-dir --no-deps /app/qgfit_src

COPY Tools/qgfit/run_qgfit.py /app/run_qgfit.py
COPY configs/qgfit/default /app/config

# SFD maps are deliberately not vendored (~160 MB).  The adapter disables
# Galactic dereddening by default and records that in run.json.  To enable it,
# mount a directory containing the four sfdmap FITS files at /opt/sfd and set
# "do_deredden": true in the config.
RUN mkdir -p /app/input /app/output /opt/sfd && chmod 777 /app/output

ENTRYPOINT ["python", "/app/run_qgfit.py"]
