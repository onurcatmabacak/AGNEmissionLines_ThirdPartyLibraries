# - {name: temperature.val, datatype: float64}
# - {name: temperature.min, datatype: float64}
# - {name: temperature.max, datatype: float64}
# - {name: tau.val, datatype: float64}
# - {name: tau.min, datatype: float64}
# - {name: tau.max, datatype: float64}
# - {name: wavelength.val, datatype: float64}
# - {name: wavelength.min, datatype: float64}
# - {name: wavelength.max, datatype: float64}
# - {name: power.val, datatype: float64}
# - {name: power.min, datatype: float64}
# - {name: power.max, datatype: float64}
# - {name: fwhm.val, datatype: float64}
# - {name: fwhm.min, datatype: float64}
# - {name: fwhm.max, datatype: float64}
# - {name: model, datatype: string}
# - {name: geometry, datatype: string}
# meta: !!omap
# - user_unit:
#     flux: !astropy.units.Unit {unit: MJy / sr}
# - {redshift: 0.000811}
# - instrument: [spitzer.irs.sl.2, spitzer.irs.sl.1, spitzer.irs.ll.2, spitzer.irs.ll.1]
# - {fitter_message: "Both actual and predicted relative reductions in the sum of squares\n  are at most 0.000000"}
# - __serialized_columns__:
#     fwhm:
#       __class__: astropy.table.column.MaskedColumn
#       data: !astropy.table.SerializedColumn
#         max: !astropy.table.SerializedColumn {name: fwhm.max}
#         min: !astropy.table.SerializedColumn {name: fwhm.min}
#         val: !astropy.table.SerializedColumn {name: fwhm.val}
#       unit: &id001 !astropy.units.Unit {unit: um}
#     power:
#       __class__: astropy.table.column.MaskedColumn
#       data: !astropy.table.SerializedColumn
#         max: !astropy.table.SerializedColumn {name: power.max}
#         min: !astropy.table.SerializedColumn {name: power.min}
#         val: !astropy.table.SerializedColumn {name: power.val}
#       unit: !astropy.units.Unit {unit: 1e-10 W / (sr m2)}
#     tau:
#       __class__: astropy.table.column.MaskedColumn
#       data: !astropy.table.SerializedColumn
#         max: !astropy.table.SerializedColumn {name: tau.max}
#         min: !astropy.table.SerializedColumn {name: tau.min}
#         val: !astropy.table.SerializedColumn {name: tau.val}
#     temperature:
#       __class__: astropy.table.column.MaskedColumn
#       data: !astropy.table.SerializedColumn
#         max: !astropy.table.SerializedColumn {name: temperature.max}
#         min: !astropy.table.SerializedColumn {name: temperature.min}
#         val: !astropy.table.SerializedColumn {name: temperature.val}
#       unit: !astropy.units.Unit {unit: K}
#     wavelength:
#       __class__: astropy.table.column.MaskedColumn
#       data: !astropy.table.SerializedColumn
#         max: !astropy.table.SerializedColumn {name: wavelength.max}
#         min: !astropy.table.SerializedColumn {name: wavelength.min}
#         val: !astropy.table.SerializedColumn {name: wavelength.val}
#       unit: *id001
# schema: astropy-2.0
