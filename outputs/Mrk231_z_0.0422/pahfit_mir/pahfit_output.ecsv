# meta: !!omap
# - user_unit:
#     flux: !astropy.units.Unit {unit: MJy / sr}
# - redshift: [spitzer.irs.sl.2, spitzer.irs.sl.1, spitzer.irs.ll.2, spitzer.irs.ll.1]
